SITE_LOCK_ENABLED=false
SITE_PREVIEW_PASSWORD=
# Eigenes HMAC-Secret fuer das Preview-Access-Cookie. Fehlt es, wird
# SITE_PREVIEW_PASSWORD als Signaturschluessel verwendet — bitte setzen.
SITE_PREVIEW_COOKIE_SECRET=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
TICKETMASTER_API_KEY=
NEXT_PUBLIC_PD24_INTERNAL_MONETIZATION_DEBUG=false

# Ohne Allowlist ist der interne Monetization-Admin geschlossen (kein
# Auto-Admin-Fallback mehr, siehe Security-Audit Fund 11).
PD24_INTERNAL_ADMIN_EMAILS=
PD24_INTERNAL_ADMIN_USER_IDS=

# Shared Secret fuer /api/affiliate/postback/<network>. PFLICHT, sobald
# Postbacks empfangen werden sollen: ohne diesen Wert antwortet der Endpunkt
# fail-closed mit 503 (Security-Audit Fund 3).
# Bevorzugt per Header X-PD24-Postback-Secret senden, Query-Param pd24_secret
# ist nur Fallback fuer Netzwerke ohne Header-Support.
AFFILIATE_POSTBACK_SECRET=

# Optional: zusaetzliche Hosts, zu denen /api/monetization/redirect weiterleiten
# darf (kommagetrennt). Die gaengigen Affiliate- und Buchungspartner sind in
# lib/security/safe-url.ts fest hinterlegt (Security-Audit Fund 8).
AFFILIATE_REDIRECT_ALLOWED_HOSTS=

# Optional: auf "true" setzen, damit die Content-Security-Policy scharf greift
# statt nur zu berichten. Vorher die Konsole auf Report-Only-Verstoesse pruefen
# (Security-Audit Fund 10).
CSP_ENFORCE=false

# ─── Web-Analytics (Plausible, cookielos) ────────────────────────────────────
# Ohne NEXT_PUBLIC_PLAUSIBLE_DOMAIN ist die Messung komplett aus (No-Op).
# Wert = die in Plausible angelegte Site, also "perfectday24.de".
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Nur fuer eine selbst gehostete Plausible-Instanz noetig.
PLAUSIBLE_HOST=https://plausible.io
# Auf "true" setzen, wenn die Messung trotz Cookie-Freiheit erst nach
# ausdruecklicher Einwilligung laufen soll (kostet real viel Reichweite).
NEXT_PUBLIC_ANALYTICS_REQUIRE_CONSENT=false
# Schreibt jedes Ereignis zusaetzlich in die Browser-Konsole — zum Pruefen der
# Instrumentierung vor dem Launch.
NEXT_PUBLIC_ANALYTICS_DEBUG=false
