{
  "name": "perfectday24",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "regression:build": "tsc -p tsconfig.regression.json",
    "regression:planner": "node .codex-regression-dist/scripts/planner-trace-regression.js",
    "regression:preferences": "node .codex-regression-dist/scripts/planner-preference-regression.js",
    "regression:core-cities": "node .codex-regression-dist/scripts/planner-city-core-regression.js",
    "check:quality": "node .codex-regression-dist/scripts/planner-quality-check.js",
    "check:visible-cities": "node .codex-scripts-dist/scripts/check-planner-visible-cities.js",
    "check:rollout-scope": "node .codex-scripts-dist/scripts/check-planner-rollout-scope.js",
    "check:top13-events": "node .codex-scripts-dist/scripts/planner-top13-event-check.js",
    "check:wave1-planner": "node .codex-scripts-dist/scripts/planner-wave1-audit.js",
    "check:wave2-planner": "node .codex-scripts-dist/scripts/planner-wave2-audit.js",
    "check:planner": "npm run check:planner:stack",
    "check:planner:core": "npm run typecheck && npm run regression:build && npm run regression:core-cities",
    "check:planner:quality": "npm run typecheck && npm run regression:build && npm run check:quality",
    "check:planner:stack": "npm run typecheck && npm run regression:build && npm run regression:core-cities && npm run check:quality",
    "events:build": "tsc -p tsconfig.scripts.json",
    "locations:ingest:city": "node .codex-scripts-dist/scripts/ingest-city-location-seeds.js",
    "locations:ingest:food-backfill": "node .codex-scripts-dist/scripts/ingest-city-location-seeds.js --focus=food",
    "locations:ingest:top10": "node .codex-scripts-dist/scripts/ingest-top10-city-rollout.js",
    "locations:ingest:top33": "node .codex-scripts-dist/scripts/ingest-top33-city-rollout.js",
    "events:ingest:ticketmaster": "node .codex-scripts-dist/scripts/ingest-ticketmaster-events.js",
    "events:ingest:ticketmaster:rollout33": "node .codex-scripts-dist/scripts/ingest-ticketmaster-events.js --city=berlin-berlin,hamburg-hamburg,muenchen,koeln,frankfurt-am-main,stuttgart,duesseldorf,leipzig,dresden,hannover,nuernberg,bremen,dortmund,essen,bonn,muenster,mannheim,wiesbaden,aachen,karlsruhe,duisburg,bochum,wuppertal,bielefeld,augsburg,braunschweig,kiel,gelsenkirchen,moenchengladbach,magdeburg,freiburg-im-breisgau,luebeck,erfurt --pages=1 --delay-ms=400",
    "events:ingest:openagenda": "node .codex-scripts-dist/scripts/ingest-openagenda-events.js",
    "events:ingest:official": "node .codex-scripts-dist/scripts/ingest-official-city-events.js",
    "events:coverage": "node .codex-scripts-dist/scripts/report-event-coverage.js",
    "events:refresh:ticketmaster": "npm run events:build && npm run events:ingest:ticketmaster:rollout33 && npm run events:coverage",
    "events:refresh:official": "npm run events:build && npm run events:ingest:official -- --provider=all --delay-ms=1500 --continue-on-error=true && npm run events:coverage",
    "routes:ingest:editorial": "node .codex-scripts-dist/scripts/ingest-editorial-routes.js",
    "routes:images:suggest": "node .codex-scripts-dist/scripts/suggest-route-images.js",
    "routes:images:review": "node .codex-scripts-dist/scripts/create-route-image-review.js",
    "routes:images:apply": "node .codex-scripts-dist/scripts/apply-route-images.js",
    "routes:images:backfill-covers": "node .codex-scripts-dist/scripts/backfill-route-covers-from-stop-photos.js",
    "routes:images:backfill-stop-context": "node .codex-scripts-dist/scripts/backfill-stop-photos-from-route-context.js",
    "routes:images:report-gaps": "node .codex-scripts-dist/scripts/report-route-image-gaps.js"
  },
  "dependencies": {
    "@stripe/stripe-js": "^9.5.0",
    "@supabase/supabase-js": "^2.96.0",
    "leaflet": "^1.9.4",
    "leaflet-routing-machine": "^3.2.12",
    "next": "16.1.6",
    "openai": "^6.22.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-leaflet": "^5.0.0",
    "stripe": "^22.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
